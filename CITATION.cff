type: software
title: "Belleq Local distributed retrieval laboratory and empirical simulator"
authors:
  - name: "Belleq Local contributors"
version: 0.2.0
date-released: 2026-11-08
license: MIT
repository-code: "https://github.com/sstprk/belleq-local"
